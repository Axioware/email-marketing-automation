# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# API
AUTH_TOKEN=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Google Maps scraper container (lead source "Scraper container")
MAPS_SCRAPER_URL=http://127.0.0.1:8001
# X-API-Key the scraper expects (its SCRAPER_API_KEY); needed when it runs behind nginx
MAPS_SCRAPER_KEY=

# Email verification (Reacher)
VERIFY_MAIL_FROM=verify@yourdomain.com
VERIFY_HELO=yourdomain.com
# Local Docker (managed by the app) or your own server, e.g. https://your-domain/reacher
REACHER_URL=http://127.0.0.1:8080
# x-reacher-secret Reacher expects (its RCH__HEADER_SECRET); required for a remote Reacher
REACHER_SECRET=

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Open tracking (off: OPEN_TRACKING in pipeline/services/generation.py)
EMAIL_TRACKING_BASE_URL=

# Name in each email's sign-off (empty: "The Axioware team")
SENDER_NAME=

# GoHighLevel (sub-account Private Integration token, its location id, and the secret its webhooks send)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# Pipeline runs: local (start here) or queue (Vercel: a worker runs them with `manage.py run_worker`)
RUN_MODE=local
