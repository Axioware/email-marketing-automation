# Database (Supabase; the pooler URL works on IPv4-only networks)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# API
AUTH_TOKEN=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Google Maps scraper container (lead source "Scraper container")
MAPS_SCRAPER_URL=http://127.0.0.1:8001
# X-API-Key the scraper expects (its SCRAPER_API_KEY), if it checks one
MAPS_SCRAPER_KEY=

# Web search for decision makers (the local SearXNG from docker-compose.yml)
SEARXNG_URL=http://127.0.0.1:8888
# Any random text; SearXNG needs one internally (generate: python -c "import secrets; print(secrets.token_hex(24))")
SEARXNG_SECRET=
# Optional: Jina Reader key (reads websites for research and decision makers); raises its 20 requests/minute limit
JINA_API_KEY=

# Email verification (Reacher in local Docker, started by the app)
VERIFY_MAIL_FROM=verify@yourdomain.com
VERIFY_HELO=yourdomain.com
REACHER_URL=http://127.0.0.1:8080

# Sending: your mailbox's SMTP server (e.g. smtp.gmail.com or smtp.office365.com)
SMTP_HOST=
# 587 with starttls, 465 with ssl
SMTP_PORT=587
# starttls, ssl or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
# For Gmail/Google Workspace an app password, not your login password
SMTP_PASSWORD=
# The From address (usually the same as SMTP_USERNAME)
SENDER_EMAIL=
# Name in the From header and each email's sign-off (empty: "The Axioware team" in the sign-off)
SENDER_NAME=

# Open tracking (off: OPEN_TRACKING in pipeline/services/generation.py)
EMAIL_TRACKING_BASE_URL=
