# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Email verification (Reacher)
VERIFY_MAIL_FROM=verify@yourdomain.com
VERIFY_HELO=yourdomain.com
REACHER_URL=http://127.0.0.1:8080

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Open tracking
EMAIL_TRACKING_BASE_URL=

# SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=you@yourdomain.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=you@yourdomain.com
SMTP_FROM_NAME=
SMTP_REPLY_TO=
