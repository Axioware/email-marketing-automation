# Copy to .env and fill in. Never commit .env.

# Required by every script and Alembic (PostgreSQL connection string)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DATABASE

# Module 2 only: website research agent (research_business_websites.py)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Module 4 only: email verification (verify_contact_emails.py)
# Reacher engine (default): the server's sender/HELO are set on the Docker container, see README.
# REACHER_URL=http://127.0.0.1:8080
# REACHER_API_SECRET=
# Built-in SMTP engine (--engine smtp): sender used in probes; an address on a domain you control with valid DNS.
VERIFY_MAIL_FROM=verify@yourdomain.com
# Optional: hostname announced to mail servers (defaults to this machine's FQDN).
# VERIFY_HELO=host.yourdomain.com
