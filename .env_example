# Copy to .env and fill in. Never commit .env.

# Required by every script and Alembic (PostgreSQL connection string)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DATABASE

# Module 2 only: website research agent (research_business_websites.py).
# Groq is used when GROQ_API_KEY (or GROK_API_KEY) is set; otherwise OpenAI.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Module 4 only: email verification (verify_contact_emails.py) with a local Reacher Docker container.
# Sender identity Reacher announces to mail servers. Use a domain you own that RECEIVES mail: servers reject
# checks from senders that cannot receive mail, and real mailboxes then look invalid. Placeholders like example.org are refused.
VERIFY_MAIL_FROM=verify@yourdomain.com
# Must be a fully-qualified hostname, otherwise mail servers refuse the checks. With no domain, use your IP as an
# address literal, e.g. [203.0.113.7] (update it when your IP changes).
VERIFY_HELO=yourdomain.com
# Optional: local port of the Reacher container.
# REACHER_URL=http://127.0.0.1:8080
